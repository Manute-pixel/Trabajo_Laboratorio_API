
# Configuración de la base de datos (reemplazar con los valores locales)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/NOMBRE_BASE_DATOS?schema=public"

JWT_SECRET="clave_secreta_para_jwt"

# Alternativa por variables individuales:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=NOMBRE_BASE_DATOS
# DB_USER=USUARIO
# DB_PASSWORD=CONTRASENA

# Solo para el script de creación del primer administrador.
ADMIN_NOMBRE="Administrador inicial"
