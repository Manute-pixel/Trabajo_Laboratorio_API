{
  "name": "Poncho Digital API",
  "version": "1.0.0",
  "description": "API REST desarrollada para el proyecto **Poncho Digital**, una plataforma digital destinada a brindar informacion y gestionar los datos relacionados con los artesanos, productos y stands de la Fiesta Nacional e Internacional del Poncho.",
  "main": "src/app.js",
  "scripts": {
    "start": "node --experimental-strip-types src/app.js",
    "dev": "node --experimental-strip-types --watch src/app.js",
    "init-admin": "node --experimental-strip-types ./src/scripts/inicializar-admin.js",
    "jwt-secret": "node -p require('node:crypto').randomBytes(32).toString('hex')",
    "db:test:preparar": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy",
    "test:unitarios": "node --test tests/unitarios/index.js",
    "test:integracion": "node --env-file=.env.test --test tests/integracion/index.test.js",
    "test:rutas": "node --env-file=.env.test --test tests/rutas/index.test.js",
    "test": "pnpm run test:unitarios && pnpm run test:integracion && pnpm run test:rutas",
    "docs": "node generar-docs.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manute-pixel/Trabajo_Laboratorio_API.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Manute-pixel/Trabajo_Laboratorio_API/issues"
  },
  "homepage": "https://github.com/Manute-pixel/Trabajo_Laboratorio_API#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "express": "^5.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.2",
    "swagger-autogen": "^2.23.7",
    "zod": "4.6.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
