// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria_Producto {
  id Int @id @default(autoincrement())
  nombre_categoria String  @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productos Producto[]
}

model Localidad {
  id Int @id @default(autoincrement())
  nombre_localidad String @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artesanos Artesano[]
}

model Provincia {
  id Int @id @default(autoincrement())
  nombre_provincia String @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artesanos Artesano[]
}

model Rubro {
  id Int @id @default(autoincrement())
  nombre_rubro String @unique @db.VarChar(100)
  descripcion String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artesanos Artesano[]
}

model Artesano {
  id Int @id @default(autoincrement())
  nombre_artesano String @db.VarChar(100)
  apellido_artesano String @db.VarChar(100)
  dni String @unique @db.VarChar(10)
  fecha_Nacimiento DateTime @db.Date
  rubroId Int
  localidadId Int
  provinciaId Int
  email_artesano String @unique @db.VarChar(100)
  telefono_artesano String @db.VarChar(20)
  usuarioId String @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rubro Rubro @relation (fields: [rubroId], references: [id], onDelete: Restrict)
  localidad Localidad @relation (fields: [localidadId], references: [id], onDelete: Restrict)
  provincia Provincia @relation (fields: [provinciaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  productos Producto[]
  stands Stand[]
  postulaciones Postulacion[]
}


model Producto {
  id Int @id @default(autoincrement())
  nombre_producto String @db.VarChar(100) 
  descripcion String @db.Text
  precio_producto Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoriaId Int
  artesanoId Int
  
  categoria Categoria_Producto @relation (fields: [categoriaId], references: [id], onDelete: Restrict)
  artesano Artesano @relation (fields: [artesanoId], references: [id], onDelete: Restrict)
}

model Stand {
  id Int @id @default(autoincrement())
  numero_stand Int
  estado_stand String @default("DISPONIBLE") @db.VarChar(15)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sectorId Int
  artesanoId Int?

  sector Sector @relation (fields: [sectorId], references: [id], onDelete: Restrict)
  artesano Artesano? @relation (fields: [artesanoId], references: [id], onDelete: Restrict)

  @@unique([numero_stand, sectorId])
}

model Pabellon {
  id Int @id @default(autoincrement())
  nombre_pabellon String @db.VarChar(100) @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edicionId Int
  edicion Edicion_Poncho @relation (fields: [edicionId], references: [id], onDelete: Restrict)

  sectores Sector[]
}

model Sector {
  id Int @id @default(autoincrement())
  nombre_sector String @db.VarChar(100) @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pabellonId Int
  pabellon Pabellon @relation (fields: [pabellonId], references: [id], onDelete: Restrict)

  stands Stand[]
}

model Edicion_Poncho {
  id Int @id @default(autoincrement())
  nombre_edicion String @db.VarChar(100) @unique
  anio_edicion Int @unique
  fecha_inicio DateTime @db.Date
  fecha_fin DateTime @db.Date
  estado_edicion String @default("PLANIFICADA") @db.VarChar(100)

  pabellones Pabellon[]
  postulaciones Postulacion[]
}

model  Postulacion {
  id Int @id @default(autoincrement())
  fecha_postulacion DateTime @default(now())
  estado_postulacion String @default("Pendiente") @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artesanoId Int
  edicionId Int

  artesano Artesano @relation (fields: [artesanoId], references: [id], onDelete: Restrict)
  edicion Edicion_Poncho @relation (fields: [edicionId], references: [id], onDelete: Restrict)
}

model Usuario {
  id String @id @default(uuid()) @db.Uuid
  nombre_usuario String @db.VarChar(100)
  apellido_usuario String @db.VarChar(100)
  email_usuario String @unique @db.VarChar(100)
  password String @db.VarChar(100)
  roles UsuarioRol[]
  activo Boolean @default(true)
  ultimoAcceso DateTime?
  participante Artesano?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rol {
  id Int @id @default(autoincrement())
  nombre_rol String @unique
  usuarios UsuarioRol[]  
}

model UsuarioRol {
  usuarioId String @db.Uuid
  rolId Int

  usuario Usuario @relation(fields:[usuarioId], references:[id], onDelete: Cascade)
  rol Rol @relation(fields: [rolId], references: [id], onDelete: Restrict)

  @@id([usuarioId, rolId])
}

model Consulta {
  id Int @id @default(autoincrement())
  tipo_consulta String @db.VarChar(100)
  fecha_consulta DateTime @default(now())
  busqueda_realizada String @db.Text
}

model TokenRevocado {
  jti     String   @id
  venceEn DateTime

  @@index([venceEn])
}